# ---------------------------
# Common
# ---------------------------
# Must include the browser origin of pramool.in.th (see NEXT_PUBLIC_* below).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://YOUR_PUBLIC_IP:3000
JWT_SECRET=change-me
JWT_EXPIRE_TIME=1
JWT_REFRESH_EXPIRE_TIME=168

# Optional (pramool-core OTP integration)
ADDRESS_REQUEST=
ADDRESS_VERIFY=
API_KEY=
API_SECRET=

# ---------------------------
# Database for pramool-core
# (hostname "postgres" = Docker service in deploy/vps/docker-compose.yml)
# ---------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pramool

# ---------------------------
# Database DSN for wallet service
# ---------------------------
DATABASE_DSN=postgres://postgres:postgres@postgres:5432/pramool?sslmode=disable

# ---------------------------
# Auction service
# ---------------------------
AUCTION_DATABASE_URL=postgres://postgres:postgres@postgres:5432/pramool?sslmode=disable
WALLET_INTERNAL_KEY=change-this-shared-key
AUCTION_INTERNAL_KEY=change-this-auction-internal-key
ESCROW_AUTO_CONFIRM_DAYS=14

# ---------------------------
# Wallet / Omise
# ---------------------------
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
OMISE_SYSTEM_RECIPIENT_ID=

# ---------------------------
# PostgREST
# (lab: use postgres role if you have not created web_anon + grants yet)
# ---------------------------
PGRST_DB_URI=postgres://postgres:postgres@postgres:5432/pramool?sslmode=disable
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=postgres
PGRST_OPENAPI_MODE=follow-privileges
PGRST_DB_POOL=10

# ---------------------------
# Next.js (pramool-frontend) — baked in at `docker compose build` time
# Use the same host your browser will use to open the site (e.g. VPS public IP + port).
# After changing these, run: docker compose build pramool-frontend --no-cache && docker compose up -d
# ---------------------------
NEXT_PUBLIC_CORE_API_BASE_URL=http://YOUR_PUBLIC_IP:3001
NEXT_PUBLIC_USER_API_BASE_URL=http://YOUR_PUBLIC_IP:3001
NEXT_PUBLIC_WALLET_API_BASE_URL=http://YOUR_PUBLIC_IP:3102
NEXT_PUBLIC_AUCTION_REALTIME_BASE_URL=http://YOUR_PUBLIC_IP:3103

# ---------------------------
# Host ports (optional override)
# ---------------------------
FRONTEND_PORT=3000
CORE_PORT=3001
WALLET_PORT=3102
AUCTION_PORT=3103
POSTGREST_PORT=3104
