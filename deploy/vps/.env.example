# ---------------------------
# Common
# ---------------------------
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com
JWT_SECRET=change-me
JWT_EXPIRE_TIME=1
JWT_REFRESH_EXPIRE_TIME=168

# Optional (pramool-core OTP integration)
ADDRESS_REQUEST=
ADDRESS_VERIFY=
API_KEY=
API_SECRET=

# ---------------------------
# Database for pramool-core
# ---------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pramool

# ---------------------------
# Database DSN for wallet service
# ---------------------------
DATABASE_DSN=postgres://postgres:postgres@127.0.0.1:5432/pramool?sslmode=disable

# ---------------------------
# Auction service
# ---------------------------
AUCTION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pramool?sslmode=disable
WALLET_INTERNAL_KEY=change-this-shared-key
AUCTION_INTERNAL_KEY=change-this-auction-internal-key
ESCROW_AUTO_CONFIRM_DAYS=14

# ---------------------------
# Wallet / Omise
# ---------------------------
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
OMISE_SYSTEM_RECIPIENT_ID=

# ---------------------------
# PostgREST
# ---------------------------
PGRST_DB_URI=postgres://postgres:postgres@127.0.0.1:5432/pramool?sslmode=disable
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=web_anon
PGRST_OPENAPI_MODE=follow-privileges
PGRST_DB_POOL=10

# ---------------------------
# Host ports (optional override)
# ---------------------------
CORE_PORT=3001
WALLET_PORT=3102
AUCTION_PORT=3103
POSTGREST_PORT=3104
